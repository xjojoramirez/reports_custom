<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="dashboard_sales_by_item" model="spreadsheet.dashboard">
        <field name="name">Sales by Item</field>
        <field name="spreadsheet_binary_data" type="base64" file="reports_custom/data/files/sales_by_item.json"/>
        <field name="main_data_model_ids" eval="[(4, ref('sale.model_sale_report'))]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_management_reports"/>
        <field name="group_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="sequence">10</field>
        <field name="is_published">True</field>
    </record>

    <record id="dashboard_sales_by_customer" model="spreadsheet.dashboard">
        <field name="name">Sales by Customer</field>
        <field name="spreadsheet_binary_data" type="base64" file="reports_custom/data/files/sales_by_customer.json"/>
        <field name="main_data_model_ids" eval="[(4, ref('sale.model_sale_report'))]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_management_reports"/>
        <field name="group_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="sequence">20</field>
        <field name="is_published">True</field>
    </record>

    <record id="dashboard_sales_by_category" model="spreadsheet.dashboard">
        <field name="name">Sales by Category</field>
        <field name="spreadsheet_binary_data" type="base64" file="reports_custom/data/files/sales_by_category.json"/>
        <field name="main_data_model_ids" eval="[(4, ref('sale.model_sale_report'))]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard_group_management_reports"/>
        <field name="group_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="sequence">30</field>
        <field name="is_published">True</field>
    </record>

</odoo>
